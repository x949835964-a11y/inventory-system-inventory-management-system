# Copy this file to .env and fill in your values. Never commit .env to Git.

# Flask CLI entry point and environment (development | production)
FLASK_APP=run.py
APP_ENV=development

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
DATABASE_URL=mysql+pymysql://inventory_user:change_this_password@localhost:3306/inventory_db?charset=utf8mb4

# Optional
# Public demo: shows demo credentials on the login page and protects the demo accounts
DEMO_MODE=false
# Managed MySQL with TLS (e.g. Aiven): path to the provider's CA certificate
# DATABASE_SSL_CA=/etc/secrets/ca.pem
BUSINESS_NAME=Bodega Don Lucho
ITEMS_PER_PAGE=15
APP_TIMEZONE=America/Lima

# Tests use in-memory SQLite. To also run the concurrency test against MySQL, point this to a
# SEPARATE, disposable database (tests drop and recreate all tables):
# TEST_DATABASE_URL=mysql+pymysql://inventory_user:change_this_password@localhost:3306/inventory_test?charset=utf8mb4
